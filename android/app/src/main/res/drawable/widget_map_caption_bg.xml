<?xml version="1.0" encoding="utf-8"?>
<!-- Bottom scrim behind the mini-map address caption — dark near the bottom
     edge (where the text sits) fading to fully transparent toward the top,
     so the caption stays legible over any tile colors underneath it. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:angle="90"
        android:startColor="#CC000000"
        android:endColor="#00000000"
        android:type="linear" />
</shape>
