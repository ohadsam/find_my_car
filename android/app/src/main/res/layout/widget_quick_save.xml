<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/widget_quick_save_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:elevation="4dp"
        android:background="@drawable/widget_background_accent">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_widget_pin"
            android:contentDescription="@null" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="שמור חניה"
            android:textColor="#FFFFFF"
            android:textSize="10.5sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_quick_actions_btn"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_gravity="top|end"
        android:layout_margin="2dp"
        android:gravity="center"
        android:textSize="13sp"
        android:textColor="#FFFFFF"
        android:text="⋮" />

    <!-- Background-detection liveness dots (WidgetStatus tints these): 📍 GPS
         and Bluetooth. Green = working, amber = running but Android is
         withholding background updates, red = should be running and isn't,
         gray = deliberately off / nothing to do. Deliberately small and
         low-contrast: this is a reassurance glance, not a call to action. -->
    <LinearLayout
        android:id="@+id/widget_status_row"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_gravity="bottom|start"
        android:layout_margin="3dp"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/widget_status_gps"
            android:layout_width="11dp"
            android:layout_height="11dp"
            android:src="@drawable/ic_status_gps"
            android:contentDescription="@null" />

        <ImageView
            android:id="@+id/widget_status_bt"
            android:layout_width="11dp"
            android:layout_height="11dp"
            android:layout_marginStart="4dp"
            android:src="@drawable/ic_status_bt"
            android:contentDescription="@null" />
    </LinearLayout>
</FrameLayout>
